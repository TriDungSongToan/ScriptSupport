<Window x:Class="ScriptSupport.Views.ConfigEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:ScriptSupport.Views"
        xmlns:Behaviors="clr-namespace:ScriptSupport.Behaviors"
        xmlns:Converters="clr-namespace:ScriptSupport.Converters"
        xmlns:Controls="clr-namespace:ScriptSupport.Controls"
        xmlns:States="clr-namespace:ScriptSupport.States"
        xmlns:ViewModels="clr-namespace:ScriptSupport.ViewModels"
        xmlns:Localization="clr-namespace:ScriptSupport.Localization"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontWeight="Medium"
        Style="{StaticResource MaterialDesignWindow}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        Background="Transparent"
        d:DataContext="{d:DesignInstance Type=ViewModels:SettingViewModel}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Auto"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="Setting" Height="auto" Width="auto" >

    <!-- Text="{Binding Source={x:Static Localization:LocalizationProxy.Instance}, Path=[Config]}" -->
    <!-- Text="{Localization:Lang Config}" -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Styles/TwoStateToggleStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Styles/TriStateToggleStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Converters:NullableIntConverter x:Key="NullableIntConverter" />
            <Converters:FontFamilyConverter x:Key="FontFamilyConverter" />

            <Style x:Key="TwoStateToggleStyleSetting" TargetType="{x:Type Controls:TwoStateToggle}"
                   BasedOn="{StaticResource {x:Type Controls:TwoStateToggle}}" >
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="IsThreeState" Value="False"/>
                <Setter Property="FalseBackgroundBrush" Value="#404842"/>
                <Setter Property="TrueBackgroundBrush" Value="#20C853"/>
                <Setter Property="ThumbBackgroundBrush" Value="#90EFEFEF"/>
                <Setter Property="ThumbBackgroundHoverBrush" Value="#AAEFEFEF"/>
                <Setter Property="TrackCornerRadius" Value="8"/>
                <Setter Property="TrackFalseCornerRadius" Value="8,5,5,8"/>
                <Setter Property="TrackTrueCornerRadius" Value="5,8,8,5"/>
                <Setter Property="FalseCellContentZIndex" Value="3"/>
                <Setter Property="TrueCellContentZIndex" Value="3"/>
                <Setter Property="ThumbZIndex" Value="3"/>
                <Setter Property="ThumbBorderBrush" Value="#8A000000"/>
                <Setter Property="ThumbBorderThickness" Value="0.5"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <materialDesign:Card UniformCornerRadius="5" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding UIConfig.FlowDirection}"
                         BorderBrush="{Binding UIConfig.ThemeColor}"
                         Background="{Binding UIConfig.Background}"
                         BorderThickness="1,0,1,1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border Height="30" Grid.Row="0" CornerRadius="5"
                    Background="{Binding UIConfig.ThemeColor}"
                    BorderThickness="0,0,0,0" Padding="6,3,6,3"
                    MouseLeftButtonDown="blsetting_MouseLeftButtonDown" >
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Images/Settings/Setting.ico" Width="auto" Height="23" Margin="0,0,10,0"
                           IsHitTestVisible="False" VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Localization:Lang Config}" FontWeight="Medium" IsHitTestVisible="False"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center"
                               Foreground="{Binding UIConfig.Foreground}"
                               FontFamily="{Binding UIConfig.FontFamily}"
                               FontSize="{Binding UIConfig.FontSize}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="5" Margin="5" BorderThickness="1" CornerRadius="5"
                        BorderBrush="{Binding UIConfig.ThemeColor}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" >
                    <StackPanel Orientation="Vertical" >
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Hidden"
                                      CanContentScroll="False" Height="270" >
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Width="500" >

                                <Expander HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                          materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,0,5"
                                          materialDesign:ExpanderAssist.VerticalHeaderPadding="0"
                                          materialDesign:ExpanderAssist.HeaderBackground="#7F888888"
                                          Background="{Binding UIConfig.Background}"
                                          Foreground="{Binding UIConfig.Foreground}" >
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,2,0,0" >

                                        <Grid Width="500" Margin="0,0,0,2" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Height="43"
                                                     Padding="10,13,3,0" BorderThickness="0.7"
                                                     Text="{Binding userSetting.DataSource, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderBrush="{Binding UIConfig.ThemeColor}"
                                                     Background="{Binding UIConfig.Background}"
                                                     Foreground="{Binding UIConfig.Foreground}"
                                                     FontFamily="{Binding UIConfig.FontFamily}"
                                                     FontSize="{Binding UIConfig.FontSize}"
                                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                     materialDesign:HintAssist.Hint="{Localization:Lang DataSource}"
                                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                     Behaviors:FileDropBehavior.Enable="True"
                                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                                     TextOptions.TextFormattingMode="Display"
                                                     TextOptions.TextRenderingMode="ClearType"
                                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                     materialDesign:ThemeAssist.Theme="Dark" />

                                            <Button Grid.Column="0"
                                                    Margin="0,0,5,0" Padding="0" Width="25" Height="25"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                    ToolTip="{Localization:Lang Browse}" Command="{Binding BrowseDataSourceCommand}" >
                                                <Button.Content>
                                                    <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25"
                                                                             Foreground="{Binding UIConfig.Foreground}" />
                                                </Button.Content>
                                            </Button>

                                            <ComboBox Grid.Column="2" Height="43"
                                                      BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                      BorderBrush="{Binding UIConfig.ThemeColor}"
                                                      Background="{Binding UIConfig.Background}"
                                                      Foreground="{Binding UIConfig.Foreground}"
                                                      FontFamily="{Binding UIConfig.FontFamily}"
                                                      FontSize="{Binding UIConfig.FontSize}"
                                                      ItemsSource="{Binding userSettingSource.Games}"
                                                      SelectedItem="{Binding userSetting.Game}"
                                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                      materialDesign:ColorZoneAssist.Mode="Custom"
                                                      materialDesign:HintAssist.Hint="{Localization:Lang Game}"
                                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                                      TextOptions.TextFormattingMode="Display"
                                                      TextOptions.TextRenderingMode="ClearType"
                                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="5" 
                                                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                                <ComboBox.Resources>
                                                    <Style TargetType="ScrollBar">
                                                        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Width="500" Margin="0,0,0,2" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <TextBox Grid.Column="0" Height="43"
                                                     Padding="10,13,3,0" BorderThickness="0.7"
                                                     Text="{Binding userSetting.BrowserPath, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderBrush="{Binding UIConfig.ThemeColor}"
                                                     Background="{Binding UIConfig.Background}"
                                                     Foreground="{Binding UIConfig.Foreground}"
                                                     FontFamily="{Binding UIConfig.FontFamily}"
                                                     FontSize="{Binding UIConfig.FontSize}"
                                                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                     materialDesign:HintAssist.Hint="{Localization:Lang browserPath}"
                                                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                     Behaviors:FileDropBehavior.Enable="True"
                                                     Behaviors:PasteSanitizerBehavior.Enable="True"
                                                     TextOptions.TextFormattingMode="Display"
                                                     TextOptions.TextRenderingMode="ClearType"
                                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                     materialDesign:ThemeAssist.Theme="Dark" />

                                            <Button Grid.Column="0"
                                                    Margin="0,0,5,0" Padding="0" Width="25" Height="25"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                    Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                                    ToolTip="{Localization:Lang Browse}" Command="{Binding BrowseWebPathCommand}" >
                                                <Button.Content>
                                                    <materialDesign:PackIcon Kind="FolderSearchOutline" Width="25" Height="25"
                                                                             Foreground="{Binding UIConfig.Foreground}" />
                                                </Button.Content>
                                            </Button>

                                            <ComboBox Grid.Column="2" Height="43"
                                                      BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                      BorderBrush="{Binding UIConfig.ThemeColor}"
                                                      Background="{Binding UIConfig.Background}"
                                                      Foreground="{Binding UIConfig.Foreground}"
                                                      FontFamily="{Binding UIConfig.FontFamily}"
                                                      FontSize="{Binding UIConfig.FontSize}"
                                                      ItemsSource="{Binding userSettingSource.Languages}"
                                                      SelectedItem="{Binding userSetting.Language}"
                                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                      materialDesign:ColorZoneAssist.Mode="Custom"
                                                      materialDesign:HintAssist.Hint="{Localization:Lang Language}"
                                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                                      TextOptions.TextFormattingMode="Display"
                                                      TextOptions.TextRenderingMode="ClearType"
                                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="5" 
                                                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                                <ComboBox.Resources>
                                                    <Style TargetType="ScrollBar">
                                                        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </Grid>

                                    </StackPanel>
                                    
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Height="24" >
                                            <materialDesign:PackIcon Kind="AccountCog" Width="28" Height="28" Padding="0" Margin="0"
                                                                     Foreground="{Binding UIConfig.Foreground}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Text="{Localization:Lang UserSetting}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{Binding UIConfig.Foreground}"
                                                       FontFamily="{Binding UIConfig.FontFamily}"
                                                       FontSize="{Binding UIConfig.FontSize}" />
                                        </StackPanel>
                                    </Expander.Header>
                                </Expander>

                                <Expander HorizontalAlignment="Stretch" Margin="0,0,0,2"
                                          materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,0,5"
                                          materialDesign:ExpanderAssist.VerticalHeaderPadding="0"
                                          materialDesign:ExpanderAssist.HeaderBackground="#7F888888"
                                          Background="{Binding UIConfig.Background}"
                                          Foreground="{Binding UIConfig.Foreground}" >
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,2,0,0" >

                                        <Grid Width="500" Margin="0,0,0,2" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <Grid Grid.Column="0" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtbackground" Grid.Column="0" Height="43" BorderThickness="0.7" Padding="10,13,3,0"
                                                         Text="{Binding displaySetting.Background, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderBrush="{Binding UIConfig.ThemeColor}"
                                                         Background="{Binding UIConfig.Background}"
                                                         Foreground="{Binding UIConfig.Foreground}"
                                                         FontFamily="{Binding UIConfig.FontFamily}"
                                                         FontSize="{Binding UIConfig.FontSize}"
                                                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                         materialDesign:HintAssist.Hint="{Localization:Lang Background}"
                                                         Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                         TextOptions.TextFormattingMode="Display"
                                                         TextOptions.TextRenderingMode="ClearType"
                                                         materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                         materialDesign:ThemeAssist.Theme="Dark" >
                                                </TextBox>

                                                <xctk:ColorPicker Grid.Column="2" x:Name="colorbackground" Width="60"
                                                                  Background="White" BorderThickness="0.7"
                                                                  UsingAlphaChannel="True"
                                                                  BorderBrush="{Binding UIConfig.ThemeColor}"
                                                                  SelectedColor="{Binding displaySetting.SelectedBackground}" />
                                            </Grid>

                                            <Grid Grid.Column="2" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="4" />
                                                    <ColumnDefinition Width="60" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtforeground" Grid.Column="0" Height="43" BorderThickness="0.7" Padding="10,13,3,0"
                                                         Text="{Binding displaySetting.Foreground, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderBrush="{Binding UIConfig.ThemeColor}"
                                                         Background="{Binding UIConfig.Background}"
                                                         Foreground="{Binding UIConfig.Foreground}"
                                                         FontFamily="{Binding UIConfig.FontFamily}"
                                                         FontSize="{Binding UIConfig.FontSize}"
                                                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                         materialDesign:HintAssist.Hint="{Localization:Lang Foreground}"
                                                         Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                         TextOptions.TextFormattingMode="Display"
                                                         TextOptions.TextRenderingMode="ClearType"
                                                         materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                         materialDesign:ThemeAssist.Theme="Dark" >
                                                </TextBox>

                                                <xctk:ColorPicker Grid.Column="2" x:Name="colorforeground" Width="60"
                                                                  Background="Transparent" BorderThickness="0.7"
                                                                  UsingAlphaChannel="True"
                                                                  BorderBrush="{Binding UIConfig.ThemeColor}"
                                                                  SelectedColor="{Binding displaySetting.SelectedForeground}" />
                                            </Grid>

                                            <ComboBox x:Name="cmbtheme" Grid.Column="4" Height="43"
                                                      BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                      BorderBrush="{Binding UIConfig.ThemeColor}"
                                                      Background="{Binding UIConfig.Background}"
                                                      Foreground="{Binding UIConfig.Foreground}"
                                                      FontFamily="{Binding UIConfig.FontFamily}"
                                                      FontSize="{Binding UIConfig.FontSize}"
                                                      ItemsSource="{Binding displaySettingSource.Themes}"
                                                      SelectedItem="{Binding displaySetting.Theme}"
                                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                      materialDesign:ColorZoneAssist.Mode="Custom"
                                                      materialDesign:HintAssist.Hint="{Localization:Lang Theme}"
                                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                                      TextOptions.TextFormattingMode="Display"
                                                      TextOptions.TextRenderingMode="ClearType"
                                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                                <ComboBox.Resources>
                                                    <Style TargetType="ScrollBar">
                                                        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Width="500" Margin="0,0,0,2" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="cmbfontfamily" Grid.Column="0" Height="43"
                                                      BorderThickness="0.7" IsEditable="True" Padding="10,18,12,5"
                                                      BorderBrush="{Binding UIConfig.ThemeColor}"
                                                      Background="{Binding UIConfig.Background}"
                                                      Foreground="{Binding UIConfig.Foreground}"
                                                      FontFamily="{Binding UIConfig.FontFamily}"
                                                      FontSize="{Binding UIConfig.FontSize}"
                                                      ItemsSource="{Binding displaySettingSource.FontFamilys}"
                                                      SelectedItem="{Binding displaySetting.FontFamily, Converter={StaticResource FontFamilyConverter}, Mode=TwoWay}"
                                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                      materialDesign:ColorZoneAssist.Mode="Custom"
                                                      materialDesign:HintAssist.Hint="{Localization:Lang FontFamily}"
                                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                                      TextOptions.TextFormattingMode="Display"
                                                      TextOptions.TextRenderingMode="ClearType"
                                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                                <ComboBox.Resources>
                                                    <Style TargetType="ScrollBar">
                                                        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>

                                            <Grid Grid.Column="2" >
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="txtfontsize" Grid.Column="0" Width="65" Height="43" BorderThickness="0.7" Padding="3,18,3,2"
                                                         Text="{Binding displaySetting.FontSize, Converter={StaticResource NullableIntConverter}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         BorderBrush="{Binding UIConfig.ThemeColor}"
                                                         Background="{Binding UIConfig.Background}"
                                                         Foreground="{Binding UIConfig.Foreground}"
                                                         FontFamily="{Binding UIConfig.FontFamily}"
                                                         FontSize="{Binding UIConfig.FontSize}"
                                                         VerticalAlignment="Stretch" HorizontalAlignment="Center"
                                                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                         materialDesign:HintAssist.Hint="{Localization:Lang FontSize}"
                                                         Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                                                         Behaviors:NumericOnlyBehavior.Enable="True"
                                                         TextOptions.TextFormattingMode="Display"
                                                         TextOptions.TextRenderingMode="ClearType"
                                                         materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                                                         materialDesign:ThemeAssist.Theme="Dark" />
                                                <Slider x:Name="slifontsize" Grid.Column="1" IsSelectionRangeEnabled="True" Margin="3,0,2,0"
                                                        Minimum="1" Maximum="100" Value="{Binding displaySetting.FontSize}" 
                                                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                        SelectionStart="10" SelectionEnd="20" TickFrequency="1" TickPlacement="None"
                                                        Style="{StaticResource MaterialDesignDiscreteSlider}" />
                                            </Grid>

                                            <ComboBox x:Name="cmbcodehighlight" Grid.Column="4" Height="43"
                                                      BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                      BorderBrush="{Binding UIConfig.ThemeColor}"
                                                      Background="{Binding UIConfig.Background}"
                                                      Foreground="{Binding UIConfig.Foreground}"
                                                      FontFamily="{Binding UIConfig.FontFamily}"
                                                      FontSize="{Binding UIConfig.FontSize}"
                                                      ItemsSource="{Binding displaySettingSource.HighLights}"
                                                      SelectedItem="{Binding displaySetting.HighLight}"
                                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                      materialDesign:ColorZoneAssist.Mode="Custom"
                                                      materialDesign:HintAssist.Hint="{Localization:Lang Highlight}"
                                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                                      TextOptions.TextFormattingMode="Display"
                                                      TextOptions.TextRenderingMode="ClearType"
                                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                                <ComboBox.Resources>
                                                    <Style TargetType="ScrollBar">
                                                        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                        <Setter Property="Opacity" Value="0.5" />
                                                    </Style>
                                                </ComboBox.Resources>
                                            </ComboBox>
                                        </Grid>

                                        <Grid Width="500" Margin="0,0,0,2" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="3" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <ComboBox x:Name="cmbFlowDirection" Grid.Column="0" Height="43"
                                                      BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                      BorderBrush="{Binding UIConfig.ThemeColor}"
                                                      Background="{Binding UIConfig.Background}"
                                                      Foreground="{Binding UIConfig.Foreground}"
                                                      FontFamily="{Binding UIConfig.FontFamily}"
                                                      FontSize="{Binding UIConfig.FontSize}"
                                                      SelectedIndex="{Binding displaySetting.FlowDirectionC}"
                                                      VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                      VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                      materialDesign:ColorZoneAssist.Mode="Custom"
                                                      materialDesign:HintAssist.Hint="{Localization:Lang FlowDirection}"
                                                      Style="{StaticResource MaterialDesignFilledComboBox}"
                                                      TextOptions.TextFormattingMode="Display"
                                                      TextOptions.TextRenderingMode="ClearType"
                                                      materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                      materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                                <ComboBoxItem Content="{Localization:Lang LeftToRight}" />
                                                <ComboBoxItem Content="{Localization:Lang RightToLeft}" />
                                            </ComboBox>

                                            <ComboBox x:Name="cmbTextAlignment" Grid.Column="2" Height="43"
                                                  BorderThickness="0.7" IsEditable="False" Padding="10,18,12,5"
                                                  BorderBrush="{Binding UIConfig.ThemeColor}"
                                                  Background="{Binding UIConfig.Background}"
                                                  Foreground="{Binding UIConfig.Foreground}"
                                                  FontFamily="{Binding UIConfig.FontFamily}"
                                                  FontSize="{Binding UIConfig.FontSize}"
                                                  SelectedIndex="{Binding displaySetting.TextAlignmentC}"
                                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                                  materialDesign:HintAssist.Hint="{Localization:Lang TextAlignment}"
                                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                                  TextOptions.TextFormattingMode="Display"
                                                  TextOptions.TextRenderingMode="ClearType"
                                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                                                <ComboBoxItem Content="{Localization:Lang AligLeft}" />
                                                <ComboBoxItem Content="{Localization:Lang AligRight}" />
                                                <ComboBoxItem Content="{Localization:Lang AligJustify}" />
                                                <ComboBoxItem Content="{Localization:Lang AligCenter}" />
                                            </ComboBox>
                                        </Grid>

                                    </StackPanel>
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Height="24" >
                                            <materialDesign:PackIcon Kind="FitToScreenOutline" Width="28" Height="28" Padding="0" Margin="0"
                                                                     Foreground="{Binding UIConfig.Foreground}"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <TextBlock Text="{Localization:Lang DisplaySetting}" VerticalAlignment="Center" Margin="10,0,0,0"
                                                       Foreground="{Binding UIConfig.Foreground}"
                                                       FontFamily="{Binding UIConfig.FontFamily}"
                                                       FontSize="{Binding UIConfig.FontSize}" />
                                        </StackPanel>
                                    </Expander.Header>
                                </Expander>

                                <Expander HorizontalAlignment="Stretch" Margin="0,0,0,2"
