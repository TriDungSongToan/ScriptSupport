<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" >
    <Style TargetType="TextBox" x:Key="CustomMaterialDesignFilledTextBox" 
           BasedOn="{StaticResource MaterialDesignFilledTextBox}">
        <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.UIConfig.HintAlignment, RelativeSource={RelativeSource AncestorType=Window}}" Value="Left">
                <Setter Property="materialDesign:HintAssist.HintHorizontalAlignment" Value="Left"/>
                <Setter Property="materialDesign:HintAssist.FloatingHintHorizontalAlignment" Value="Left"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding DataContext.UIConfig.HintAlignment, RelativeSource={RelativeSource AncestorType=Window}}" Value="Right">
                <Setter Property="materialDesign:HintAssist.HintHorizontalAlignment" Value="Right"/>
                <Setter Property="materialDesign:HintAssist.FloatingHintHorizontalAlignment" Value="Right"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>