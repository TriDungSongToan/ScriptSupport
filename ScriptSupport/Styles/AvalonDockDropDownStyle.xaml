<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AvalonDock="https://github.com/Dirkster99/AvalonDock">

    <!-- ============================= -->
    <!--  STYLE OVERRIDE CHO DROPDOWN  -->
    <!-- ============================= -->
    <Style TargetType="{x:Type AvalonDock:LayoutDocumentPaneControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type AvalonDock:LayoutDocumentPaneControl}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Panel chứa các tab -->
                        <AvalonDock:DocumentPaneTabPanel
                            x:Name="PART_HeaderPanel"
                            Grid.Column="0"
                            Panel.ZIndex="1" />
                        <!-- Nút dropdown -->
                        <Button x:Name="PART_DropDownButton"
                                Grid.Column="1"
                                Width="22"
                                Height="20"
                                Padding="0"
                                Margin="4,0,4,0"
                                Background="{Binding DataContext.UIConfig.Background,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Foreground="{Binding DataContext.UIConfig.Foreground,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                            <!-- Popup danh sách tab -->
                            <Button.ContextMenu>
                                <ContextMenu
                                    Background="{Binding DataContext.UIConfig.Background,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Foreground="{Binding DataContext.UIConfig.Foreground,
                                        RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ContextMenu.ItemContainerStyle>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Background"
                                                    Value="{Binding DataContext.UIConfig.Background,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                            <Setter Property="Foreground"
                                                    Value="{Binding DataContext.UIConfig.Foreground,
                                                        RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                        </Style>
                                    </ContextMenu.ItemContainerStyle>
                                    <!-- Các MenuItem sẽ được tự động sinh ra bởi AvalonDock -->
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>