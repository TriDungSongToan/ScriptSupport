<UserControl x:Class="ScriptSupport.UserControls.CardFilterText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScriptSupport.UserControls"
             xmlns:ViewModels="clr-namespace:ScriptSupport.ViewModels"
             xmlns:Converters="clr-namespace:ScriptSupport.Converters"
             xmlns:Behaviors="clr-namespace:ScriptSupport.Behaviors"
             xmlns:Localization="clr-namespace:ScriptSupport.Localization"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             mc:Ignorable="d"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             Background="Transparent"
             d:DesignHeight="100" d:DesignWidth="400">

    <UserControl.Resources>
        <ResourceDictionary>
            <Converters:SelectedItemsToVisibilityConverter x:Key="SelectedItemsToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,2" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Padding="2,8,2,1" Margin="0,0,0,0" BorderThickness="0.7"
                     Text="{Binding CardDataFilterView.IdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                     TextAlignment="{Binding UIConfig.TextAlignment}"
                     BorderBrush="{Binding UIConfig.ThemeColor}"
                     Background="Transparent"
                     Foreground="{Binding UIConfig.Foreground}"
                     FontFamily="{Binding UIConfig.FontFamily}"
                     FontSize="{Binding UIConfig.FontSize}"
                     materialDesign:HintAssist.Hint="{Localization:Lang cardID}"
                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                     ToolTip="{Localization:Lang cardID}"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextRenderingMode="ClearType"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                     materialDesign:ThemeAssist.Theme="Dark" />

            <TextBox Grid.Column="2" Padding="2,8,2,1" Margin="0,0,0,0" BorderThickness="0.7"
                     Text="{Binding CardDataFilterView.AliasText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                     VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                     TextAlignment="{Binding UIConfig.TextAlignment}"
                     BorderBrush="{Binding UIConfig.ThemeColor}"
                     Background="Transparent"
                     Foreground="{Binding UIConfig.Foreground}"
                     FontFamily="{Binding UIConfig.FontFamily}"
                     FontSize="{Binding UIConfig.FontSize}"
                     materialDesign:HintAssist.Hint="{Localization:Lang cardAlias}"
                     Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                     ToolTip="{Localization:Lang cardAlias}"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextRenderingMode="ClearType"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                     materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                     materialDesign:ThemeAssist.Theme="Dark" />

        </Grid>

        <TextBox Grid.Row="1" Padding="2,8,2,1" Margin="0,0,0,2" BorderThickness="0.7"
                 Text="{Binding CardTextFilterView.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                 TextAlignment="{Binding UIConfig.TextAlignment}"
                 BorderBrush="{Binding UIConfig.ThemeColor}"
                 Background="Transparent"
                 Foreground="{Binding UIConfig.Foreground}"
                 FontFamily="{Binding UIConfig.FontFamily}"
                 FontSize="{Binding UIConfig.FontSize}"
                 materialDesign:HintAssist.Hint="{Localization:Lang cardName}"
                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                 ToolTip="{Localization:Lang cardName}"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                 materialDesign:ThemeAssist.Theme="Dark" />

        <TextBox Grid.Row="2" Padding="2,8,2,1" Margin="0,0,0,2" BorderThickness="0.7"
                 Text="{Binding CardTextFilterView.Desc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                 TextAlignment="{Binding UIConfig.TextAlignment}"
                 BorderBrush="{Binding UIConfig.ThemeColor}"
                 Background="Transparent"
                 Foreground="{Binding UIConfig.Foreground}"
                 FontFamily="{Binding UIConfig.FontFamily}"
                 FontSize="{Binding UIConfig.FontSize}"
                 materialDesign:HintAssist.Hint="{Localization:Lang cardDesc}"
                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                 ToolTip="{Localization:Lang cardDesc}"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                 materialDesign:ThemeAssist.Theme="Dark" />

        <TextBox Grid.Row="3" Padding="2,8,2,1" Margin="0,0,0,0" BorderThickness="0.7"
                 Text="{Binding CardTextFilterView.Str, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                 VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                 TextAlignment="{Binding UIConfig.TextAlignment}"
                 BorderBrush="{Binding UIConfig.ThemeColor}"
                 Background="Transparent"
                 Foreground="{Binding UIConfig.Foreground}"
                 FontFamily="{Binding UIConfig.FontFamily}"
                 FontSize="{Binding UIConfig.FontSize}"
                 materialDesign:HintAssist.Hint="Str"
                 Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                 ToolTip="Str"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType"
                 materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                 materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                 materialDesign:ThemeAssist.Theme="Dark" />

    </Grid>
</UserControl>
