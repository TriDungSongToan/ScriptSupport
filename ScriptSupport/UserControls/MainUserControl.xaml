<UserControl x:Class="ScriptSupport.UserControls.MainUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:ScriptSupport"
             xmlns:UserControls="clr-namespace:ScriptSupport.UserControls"
             xmlns:ViewModels="clr-namespace:ScriptSupport.ViewModels"
             xmlns:Converters="clr-namespace:ScriptSupport.Converters"
             xmlns:Localization="clr-namespace:ScriptSupport.Localization"
             xmlns:States="clr-namespace:ScriptSupport.States"
             mc:Ignorable="d"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             Loaded="UserControl_Loaded"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="RegionBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="SecondaryRegionBrush" Color="Transparent"/>
            <SolidColorBrush x:Key="BorderBrush" Color="Transparent"/>

            <Style x:Key="TopLevelMenuItemStyle" TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="{Binding DataContext.UIConfig.Background, RelativeSource={RelativeSource AncestorType=Menu}}"/>
                <Setter Property="Foreground" Value="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Menu}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Grid Background="Transparent" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}">
                                <Border x:Name="HighlightBorder" Background="Transparent" IsHitTestVisible="False"/>
                                <ContentPresenter Content="{TemplateBinding Header}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom" AllowsTransparency="True" Focusable="False" VerticalOffset="0">
                                    <materialDesign:Card UniformCornerRadius="3" >
                                        <Border Background="{Binding DataContext.UIConfig.SolidBackground,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}">
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </materialDesign:Card>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HighlightBorder" Property="Background" Value="{Binding DataContext.UIConfig.ThemeColor, 
                                        RelativeSource={RelativeSource AncestorType=Menu}}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{Binding DataContext.UIConfig.SolidBackground, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderThickness="0.5" Padding="6" CornerRadius="4">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  TextElement.Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  TextElement.FontFamily="{Binding DataContext.UIConfig.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="RichTextBox" BasedOn="{StaticResource MaterialDesignFilledRichTextBox}" >
                <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" />
            </Style>

            <Style TargetType="TextBox" BasedOn="{StaticResource CustomMaterialDesignFilledTextBox}" >
                <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" />
            </Style>

            <Converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <Converters:BoolToGridLengthConverter x:Key="CardFilterGridLength" TrueValue="250" FalseValue="0"/>
            <Converters:WidthToVisibilityConverter x:Key="WidthToVisibilityMenu" Threshold="70"/>
            <Converters:WidthToVisibilityConverter x:Key="WidthToVisibilityCard" Threshold="60"/>
            <Converters:WidthToVisibilityConverter x:Key="WidthToVisibilityScrapiyard" Threshold="85"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="{Binding UIConfig.Background}"
          ClipToBounds="False">

        <Grid x:Name="MainGrid" Background="Transparent" ClipToBounds="False"
              FlowDirection="{Binding UIConfig.FlowDirection}" d:FlowDirection="LeftToRight" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="2" />
                <ColumnDefinition Width="{Binding IsOpenCardFilter,Converter={StaticResource CardFilterGridLength}}" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" >
                    <Menu x:Name="MainMenu" Padding="0" Margin="0"
                          materialDesign:MenuAssist.MenuItemsPresenterMargin="0"
                          materialDesign:MenuItemAssist.HighlightedBackground="{Binding UIConfig.ThemeColor}"
                          Background="Transparent"
                          Foreground="{Binding UIConfig.Foreground}"
                          FontFamily="{Binding UIConfig.FontFamily}"
                          FontSize="{Binding UIConfig.FontSize}" >
                        <Menu.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="3"/>
                            </ItemsPanelTemplate>
                        </Menu.ItemsPanel>

                        <MenuItem x:Name="FileMenuItem"
                                  materialDesign:MenuItemAssist.HighlightedBackground="{Binding UIConfig.ThemeColor}"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource TopLevelMenuItemStyle}"
                                  Padding="0" Margin="0" ToolTip="File" >
                            <MenuItem.Header>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="26">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="FileMoveOutline" Width="20" Height="20"
                                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             Foreground="{Binding UIConfig.Foreground}" />
                                    <TextBlock Text="{Localization:Lang File}" Grid.Column="2"
                                               Foreground="{Binding UIConfig.Foreground}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                                               Visibility="{Binding ActualWidth, ElementName=FileMenuItem, Converter={StaticResource WidthToVisibilityMenu}}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem Header="{Localization:Lang tNew}" Command="{Binding NewFileCommand}" />
                            <MenuItem Header="{Localization:Lang Open}" Command="{Binding OpenFileCommand}" />
                            <MenuItem Header="{Localization:Lang Save}" Command="{Binding SaveFileCommand}" />
                            <MenuItem Header="{Localization:Lang SaveAs}" Command="{Binding SaveAsFileCommand}" />
                            <MenuItem Header="{Localization:Lang Exit}" Command="{Binding ExitCommand}" />
                        </MenuItem>
                        <MenuItem x:Name="SettingsMenuItem"
                                  materialDesign:MenuItemAssist.HighlightedBackground="{Binding UIConfig.ThemeColor}"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource TopLevelMenuItemStyle}"
                                  Padding="0" Margin="0" ToolTip="Settings" >
                            <MenuItem.Header>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="26" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="CogOutline" Width="20" Height="20"
                                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             Foreground="{Binding UIConfig.Foreground}" />
                                    <TextBlock Text="{Localization:Lang Setting}" Grid.Column="2"
                                               Foreground="{Binding UIConfig.Foreground}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                                               Visibility="{Binding ActualWidth, ElementName=SettingsMenuItem, Converter={StaticResource WidthToVisibilityMenu}}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem Header="{Localization:Lang Config}" Command="{Binding SettingCommand}" />
                        </MenuItem>
                        <MenuItem x:Name="HelpMenuItem"
                                  materialDesign:MenuItemAssist.HighlightedBackground="{Binding UIConfig.ThemeColor}"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource TopLevelMenuItemStyle}"
                                  Padding="0" Margin="0" ToolTip="Help" >
                            <MenuItem.Header>
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Height="26" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto" />
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" Kind="TooltipQuestionOutline" Width="20" Height="20"
                                                             HorizontalAlignment="Right" VerticalAlignment="Center"
                                                             Foreground="{Binding UIConfig.Foreground}" />
                                    <TextBlock Text="{Localization:Lang Help}" Grid.Column="2"
                                               Foreground="{Binding UIConfig.Foreground}"
                                               HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5,0,0,0"
                                               Visibility="{Binding ActualWidth, ElementName=HelpMenuItem, Converter={StaticResource WidthToVisibilityMenu}}" />
                                </Grid>
                            </MenuItem.Header>
                            <MenuItem Header="{Localization:Lang ChkUpdate}" Command="{Binding CheckUpDateCommand}" />
                            <MenuItem Header="{Localization:Lang About}" Command="{Binding AboutCommand}" />
                            <MenuItem Header="{Localization:Lang SpecialChar}" Command="{Binding SpecialCharCommand}" />
                        </MenuItem>
                        <Menu.Style>
                            <Style TargetType="Menu" BasedOn="{StaticResource MaterialDesignMenu}" >
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{Binding UIConfig.Foreground}"/>
                            </Style>
                        </Menu.Style>
                        <Menu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Background" Value="{Binding UIConfig.SolidBackground}"/>
                                <Setter Property="Foreground" Value="{Binding UIConfig.Foreground}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="materialDesign:MenuItemAssist.HighlightedBackground" Value="{Binding UIConfig.ThemeColor}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Menu.Resources>
                    </Menu>
                </Grid>

                <hc:TabControl x:Name="tabCard" Grid.Row="1" 
                               BorderThickness="0" TabStripPlacement="Top" TabItemHeight="28"
                               IsTabFillEnabled="True" IsDraggable="True" ShowCloseButton="False"
                               ShowContextMenu="False" IsScrollable="True" ShowOverflowButton="True"
                               CanBeClosedByMiddleButton="False" IsAnimationEnabled="True"
                               BorderBrush="{Binding UIConfig.Foreground}"
                               Background="Transparent"
                               Foreground="{Binding UIConfig.Foreground}"
                               FontFamily="{Binding UIConfig.FontFamily}"
                               FontSize="{Binding UIConfig.FontSize}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                    <hc:TabControl.ItemContainerStyle>
                        <Style TargetType="hc:TabItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="BorderThickness" Value="0.5,0.5,0.5,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="hc:TabItem">
                                        <Border x:Name="Bd"
                                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                Background="Transparent"
                                                BorderBrush="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5,5,0,0" Padding="0" Margin="0" >
                                            <Grid>
                                                <ContentPresenter x:Name="HeaderContent"
                                                                  Content="{TemplateBinding hc:TabItem.Header}"
                                                                  Width="200" MinWidth="50" Margin="0"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  RecognizesAccessKey="True"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{Binding UIConfig.ThemeColor}"/>
                                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground"
                                                        Value="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
                                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground"
                                                        Value="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="HeaderContent" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </hc:TabControl.ItemContainerStyle>

                    <hc:TabItem>
                        <hc:TabItem.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Localization:Lang Card}">
                                <materialDesign:PackIcon Kind="CardMultiple" Margin="0" Padding="0" Background="Transparent"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBlock Text="{Localization:Lang Card}" Margin="5,0,0,0" Background="Transparent"
                                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource WidthToVisibilityCard}}"
                                           Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </hc:TabItem.Header>
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Background="Transparent" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Height="auto"
                                         Text="{Binding SearchCard, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="3,8,14,1" BorderThickness="0.5" Visibility="Visible"
                                         BorderBrush="{Binding DataContext.UIConfig.ThemeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Background="Transparent"
                                         Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontFamily="{Binding DataContext.UIConfig.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontSize="{Binding DataContext.UIConfig.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                         materialDesign:HintAssist.Hint="{Localization:Lang SearchCard}"
                                         TextOptions.TextFormattingMode="Display"
                                         TextOptions.TextRenderingMode="ClearType"
                                         materialDesign:TextFieldAssist.HasOutlinedTextField="False"
                                         materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,6,6"
                                         materialDesign:TextFieldAssist.HasFilledTextField="False"
                                         materialDesign:ThemeAssist.Theme="Dark" />

                                <ToggleButton Grid.Column="0" Width="25" Height="25" Margin="0,0,3,0" Padding="0"
                                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding IsOpenCardFilter}"
                                              ToolTip="{Localization:Lang advanFil}"
                                              Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" >
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignHamburgerToggleButton}">
                                            <Setter Property="Opacity" Value="0.3" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <Grid.ToolTip>
                                    <ToolTip Content="{Binding ResultCards}" ContentStringFormat="Result: {0}" />
                                </Grid.ToolTip>
                            </Grid>

                            <Grid Grid.Row="1" >
                                <ListBox x:Name="libSearchCard" Margin="0" Padding="0" BorderThickness="0"
                                         BorderBrush="{Binding DataContext.UIConfig.ThemeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Background="Transparent"
                                         Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontFamily="{Binding DataContext.UIConfig.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontSize="{Binding DataContext.UIConfig.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         ItemsSource="{Binding Cards}"
                                         SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                                         materialDesign:ListBoxItemAssist.CornerRadius="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Item"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding name}" Background="Transparent" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            <Setter Property="Padding" Value="3"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding DoubleClickCardCommand}"
                                                                   CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </hc:TabItem>
                    <hc:TabItem>
                        <hc:TabItem.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Localization:Lang CardScript}">
                                <materialDesign:PackIcon Kind="ScriptTextPlayOutline" Margin="0" Padding="0" Background="Transparent"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <TextBlock Text="{Localization:Lang CardScript}" Margin="5,0,0,0" Background="Transparent"
                                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource WidthToVisibilityCard}}"
                                           Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </hc:TabItem.Header>
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Background="Transparent" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0" Height="auto"
                                         Text="{Binding SearchScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="3,8,14,1" BorderThickness="0.5" Visibility="Visible"
                                         BorderBrush="{Binding DataContext.UIConfig.ThemeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Background="Transparent"
                                         Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontFamily="{Binding DataContext.UIConfig.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontSize="{Binding DataContext.UIConfig.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                         materialDesign:HintAssist.Hint="{Localization:Lang SearchScript}"
                                         TextOptions.TextFormattingMode="Display"
                                         TextOptions.TextRenderingMode="ClearType"
                                         materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,6,6"
                                         materialDesign:TextFieldAssist.HasFilledTextField="False"
                                         materialDesign:ThemeAssist.Theme="Dark" />

                                <ToggleButton Grid.Column="0" Width="25" Height="25" Margin="0,0,3,0" Padding="0"
                                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"
                                              IsChecked="{Binding IsOpenCardFilter}"
                                              ToolTip="{Localization:Lang advanFil}"
                                              Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" >
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource MaterialDesignHamburgerToggleButton}">
                                            <Setter Property="Opacity" Value="0.3" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.6" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter Property="Opacity" Value="1" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <Grid.ToolTip>
                                    <ToolTip Content="{Binding ResultScripts}" ContentStringFormat="Result: {0}" />
                                </Grid.ToolTip>
                            </Grid>

                            <Grid Grid.Row="1" >
                                <ListBox x:Name="libSearchScript" Margin="0" Padding="0" BorderThickness="0"
                                         BorderBrush="{Binding DataContext.UIConfig.ThemeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         Background="Transparent"
                                         Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontFamily="{Binding DataContext.UIConfig.FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         FontSize="{Binding DataContext.UIConfig.FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                         ItemsSource="{Binding ScriptItems}"
                                         SelectedItem="{Binding SelectedScriptItem, Mode=TwoWay}"
                                         materialDesign:ListBoxItemAssist.CornerRadius="0"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         VirtualizingPanel.ScrollUnit="Item"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" Background="Transparent" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                            <Setter Property="Padding" Value="3"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding DoubleClickScriptCommand}"
                                                                   CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </ListBox>
                            </Grid>
                        </Grid>
                    </hc:TabItem>
                    <hc:TabItem>
                        <hc:TabItem.Header>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" ToolTip="{Localization:Lang Open}">
                                <materialDesign:PackIcon Kind="FolderOpenOutline" Margin="0" Padding="0" Background="Transparent"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                <TextBlock Text="{Localization:Lang Open}" Margin="5,0,0,0" Background="Transparent"
                                           Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource WidthToVisibilityCard}}"
                                           Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </StackPanel>
                        </hc:TabItem.Header>
                        <Grid Background="Transparent">
