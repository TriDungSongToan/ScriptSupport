            <Grid Grid.Column="3" ClipToBounds="False" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" MinHeight="50" />
                    <RowDefinition Height="2" />
                    <RowDefinition Height="2*" MinHeight="50" />
