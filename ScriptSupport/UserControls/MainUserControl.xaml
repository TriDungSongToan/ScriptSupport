                <ContentControl x:Name="ResultContent" />

                <GridSplitter Grid.Row="1" Height="2"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows" ShowsPreview="False"
                              Background="{Binding UIConfig.ThemeColor}" />

                <UserControls:EditorHostControl Grid.Row="2" ClipToBounds="False" />

            </Grid>
        </Grid>

        <Canvas x:Name="OverlayCanvas"
                IsHitTestVisible="True"
                Panel.ZIndex="999"
                ClipToBounds="False"/>

    </Grid>
