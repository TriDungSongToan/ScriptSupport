<UserControl x:Class="ScriptSupport.UserControls.FloatingPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:ScriptSupport.UserControls"
             xmlns:Converters="clr-namespace:ScriptSupport.Converters"
             xmlns:Localization="clr-namespace:ScriptSupport.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">

    <materialDesign:Card UniformCornerRadius="5" d:FlowDirection="LeftToRight"
                         FlowDirection="{Binding UIConfig.FlowDirection}"
                         BorderBrush="{Binding UIConfig.ThemeColor}"
                         Background="{Binding UIConfig.Background}"
                         BorderThickness="1,0,1,1" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <Border x:Name="DragHandle" Height="25" Grid.Row="0" CornerRadius="5"
                    Background="{Binding UIConfig.ThemeColor}"
                    BorderThickness="0" Padding="0"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown"
                    MouseMove="DragHandle_MouseMove"
                    MouseLeftButtonUp="DragHandle_MouseLeftButtonUp" >
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding Title}" Grid.Column="0"
                               FontWeight="Medium" IsHitTestVisible="False"
                               FontSize="15"
                               Background="Transparent"
                               Foreground="{Binding UIConfig.Foreground}"
                               FontFamily="{Binding UIConfig.FontFamily}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <Button Background="Transparent" Cursor="Hand"
                            Grid.Column="1" Margin="0,0,5,0" Padding="0"
                            Click="Button_Click"
                            Command="{Binding CloseCommand}"
                            Foreground="{Binding UIConfig.Foreground}"
                            BorderThickness="0" BorderBrush="Transparent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center" >
                        <Button.Content>
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

            <ContentPresenter Grid.Row="1" Margin="3" Content="{Binding PanelContent}" />

        </Grid>
    </materialDesign:Card>
</UserControl>
