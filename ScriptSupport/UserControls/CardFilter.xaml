<UserControl x:Class="ScriptSupport.UserControls.CardFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScriptSupport.UserControls"
             xmlns:ViewModels="clr-namespace:ScriptSupport.ViewModels"
             xmlns:Converters="clr-namespace:ScriptSupport.Converters"
             xmlns:Behaviors="clr-namespace:ScriptSupport.Behaviors"
             xmlns:Localization="clr-namespace:ScriptSupport.Localization"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Medium"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch"
             mc:Ignorable="d"
             UseLayoutRounding="False"
             SnapsToDevicePixels="False"
             Background="Transparent"
             d:DesignHeight="500" d:DesignWidth="400">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden" >
        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Orientation="Vertical" >

            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,2"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,0,5"
                      materialDesign:ExpanderAssist.VerticalHeaderPadding="0"
                      materialDesign:ExpanderAssist.HeaderBackground="#7F888888"
                      Background="Transparent"
                      Foreground="{Binding UIConfig.Foreground}" >
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,2,0,0" >
                    <ContentControl x:Name="CardTextContent" />
                </StackPanel>

                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Height="25" >
                        <materialDesign:PackIcon Kind="AccountCog" Width="28" Height="28" Padding="0" Margin="0"
                                                 Foreground="{Binding UIConfig.Foreground}"
                                                 Background="Transparent"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Localization:Lang CardText}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Background="Transparent"
                                   Foreground="{Binding UIConfig.Foreground}"
                                   FontFamily="{Binding UIConfig.FontFamily}"
                                   FontSize="{Binding UIConfig.FontSize}" />
                    </StackPanel>
                </Expander.Header>
            </Expander>

            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,2"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,0,5"
                      materialDesign:ExpanderAssist.VerticalHeaderPadding="0"
                      materialDesign:ExpanderAssist.HeaderBackground="#7F888888"
                      Background="Transparent"
                      Foreground="{Binding UIConfig.Foreground}" >
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,2,0,0" >
                    <ContentControl x:Name="CardDataContent" />
                </StackPanel>

                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Height="25" >
                        <materialDesign:PackIcon Kind="AccountCog" Width="28" Height="28" Padding="0" Margin="0"
                                                 Foreground="{Binding UIConfig.Foreground}"
                                                 Background="Transparent"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Localization:Lang CardData}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Background="Transparent"
                                   Foreground="{Binding UIConfig.Foreground}"
                                   FontFamily="{Binding UIConfig.FontFamily}"
                                   FontSize="{Binding UIConfig.FontSize}" />
                    </StackPanel>
                </Expander.Header>
            </Expander>

            <Expander HorizontalAlignment="Stretch" Margin="0,0,0,2"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="10,5,0,5"
                      materialDesign:ExpanderAssist.VerticalHeaderPadding="0"
                      materialDesign:ExpanderAssist.HeaderBackground="#7F888888"
                      Background="Transparent"
                      Foreground="{Binding UIConfig.Foreground}" >
                <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Margin="0,2,0,0" >
                    <ContentControl x:Name="CardInfoContent" />
                </StackPanel>
                
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Height="25" >
                        <materialDesign:PackIcon Kind="AccountCog" Width="28" Height="28" Padding="0" Margin="0"
                                                 Foreground="{Binding UIConfig.Foreground}"
                                                 Background="Transparent"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="{Localization:Lang CardInfo}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Background="Transparent"
                                   Foreground="{Binding UIConfig.Foreground}"
                                   FontFamily="{Binding UIConfig.FontFamily}"
                                   FontSize="{Binding UIConfig.FontSize}" />
                    </StackPanel>
                </Expander.Header>
            </Expander>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
