<UserControl x:Class="ScriptSupport.UserControls.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ScriptSupport.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:Behaviors="clr-namespace:ScriptSupport.Behaviors"
             xmlns:Converters="clr-namespace:ScriptSupport.Converters"
             mc:Ignorable="d" 
             Unloaded="UserControl_Unloaded"
             d:DesignHeight="200" d:DesignWidth="600">
    
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <Style TargetType="ToolTip">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{Binding DataContext.UIConfig.Background, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderThickness="0.5" Padding="6" CornerRadius="4">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  TextElement.Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  TextElement.FontFamily="{Binding DataContext.UIConfig.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="RichTextBox" BasedOn="{StaticResource MaterialDesignFilledRichTextBox}" >
                <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" />
            </Style>

            <Style TargetType="avalonEdit:TextEditor" >
                <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" /> 
            </Style>

            <Converters:WidthToVisibilityConverter x:Key="WidthToVisibilityHeader" Threshold="70"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <TabControl x:Name="tabcresult" Grid.Row="0"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                    materialDesign:NavigationRailAssist.SelectionCornerRadius="10 10 10 10"
                    materialDesign:ColorZoneAssist.Mode="Custom"
                    materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                    Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                    TabStripPlacement="Left" Background="Transparent"
                    SelectedIndex="{Binding ActivateTab}" >
            <TabItem Width="40" >
                <TabItem.Header>
                    <StackPanel Width="auto" Height="auto" >
                        <materialDesign:PackIcon Width="24" Height="24" HorizontalAlignment="Center"
                                                 Kind="CardsOutline"
                                                 Background="Transparent"
                                                 Foreground="{Binding UIConfig.Foreground}" />
                        <TextBlock HorizontalAlignment="Center" Text="Card"
                                   Background="Transparent"
                                   Foreground="{Binding UIConfig.Foreground}" />
                    </StackPanel>
                </TabItem.Header>
                <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" >
                        <ComboBox Grid.Column="2" Height="auto"
                                  BorderThickness="0.7,0,0.7,0.7" IsEditable="False" Padding="5,5,5,5"
                                  BorderBrush="{Binding UIConfig.ThemeColor}"
                                  Background="{Binding UIConfig.Background}"
                                  Foreground="{Binding UIConfig.Foreground}"
                                  FontFamily="{Binding UIConfig.FontFamily}"
                                  FontSize="{Binding UIConfig.FontSize}"
                                  ItemsSource="{Binding CardTexts}"
                                  DisplayMemberPath="DBPath"
                                  SelectedItem="{Binding SelectedCardText, Mode=TwoWay}"
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                                  materialDesign:ColorZoneAssist.Mode="Custom"
                                  Style="{StaticResource MaterialDesignFilledComboBox}"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  materialDesign:ComboBoxAssist.ShowSelectedItem="True"
                                  materialDesign:TextFieldAssist.HasClearButton="True"
                                  materialDesign:TextFieldAssist.UnderlineBrush="Transparent"
                                  materialDesign:TextFieldAssist.TextFieldCornerRadius="5" 
                                  materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                            <ComboBox.Resources>
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Background" Value="{Binding SolidBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <Setter Property="Opacity" Value="0.5" />
                                </Style>
                            </ComboBox.Resources>
                            <!--<ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MaterialDesignComboBoxItemStyle}" >
                                    <Setter Property="Background" Value="{Binding DataContext.UIConfig.SolidBackground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                    <Setter Property="Foreground" Value="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>-->
                        </ComboBox>
                    </Grid>

                    <avalonEdit:TextEditor x:Name="EditorCard" BorderThickness="0.5,0.5,0,0" Grid.Row="2" Margin="0" Padding="4,0,0,0"
                                           xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                                           Document="{Binding ResultCardDocument, Mode=TwoWay}"
                                           Background="Transparent"
                                           Foreground="{Binding UIConfig.Foreground}"
                                           FontFamily="{Binding UIConfig.FontFamily}"
                                           FontSize="{Binding UIConfig.FontSize}"
                                           BorderBrush="{Binding UIConfig.Foreground}"
                                           VerticalScrollBarVisibility="Hidden"
                                           HorizontalScrollBarVisibility="Hidden"
                                           HorizontalContentAlignment="Left"
                                           VerticalContentAlignment="Top"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch"
                                           WordWrap="True" Visibility="Collapsed"
                                           ShowLineNumbers="False"
                                           SyntaxHighlighting="Lua"/>

                    <RichTextBox x:Name="rtxtCard" Grid.Row="2" Margin="0" Padding="0" BorderThickness="0.5,0,0.5,0"
                                 Background="Transparent"
                                 Behaviors:RichTextBoxBehavior.Document="{Binding ResultCardDocument1}"
                                 Foreground="{Binding UIConfig.Foreground}"
                                 FontFamily="{Binding UIConfig.FontFamily}"
                                 FontSize="{Binding UIConfig.FontSize}"
                                 BorderBrush="{Binding UIConfig.Foreground}"
                                 VerticalScrollBarVisibility="Hidden"
                                 HorizontalScrollBarVisibility="Hidden"
                                 HorizontalContentAlignment="Left"
                                 VerticalContentAlignment="Top"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 IsReadOnly="False" Focusable="True" >
                    </RichTextBox>
                </Grid>
            </TabItem>
            <TabItem Width="40" >
                <TabItem.Header>
                    <StackPanel Width="auto" Height="auto" >
                        <materialDesign:PackIcon Width="24" Height="24" HorizontalAlignment="Center"
                                                 Kind="BookOutline"
                                                 Background="Transparent"
                                                 Foreground="{Binding UIConfig.Foreground}" />
                        <TextBlock HorizontalAlignment="Center" Text="Scr"
                                   Background="Transparent"
                                   Foreground="{Binding UIConfig.Foreground}" />
                    </StackPanel>
                </TabItem.Header>
                <avalonEdit:TextEditor x:Name="EditorScrapiyard" BorderThickness="0.5,0,0,0" Margin="0" Padding="0"
                                       xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                                       Document="{Binding ResultScrapiyardDocument, Mode=TwoWay}"
                                       Background="Transparent"
                                       Foreground="{Binding UIConfig.Foreground}"
                                       FontFamily="{Binding UIConfig.FontFamily}"
                                       FontSize="{Binding UIConfig.FontSize}"
                                       BorderBrush="{Binding UIConfig.Foreground}"
                                       VerticalScrollBarVisibility="Hidden"
                                       HorizontalScrollBarVisibility="Hidden"
                                       HorizontalContentAlignment="Left"
                                       VerticalContentAlignment="Top"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       WordWrap="True"
                                       ShowLineNumbers="True"
                                       SyntaxHighlighting="{Binding SyntaxHighlighting}" />
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
