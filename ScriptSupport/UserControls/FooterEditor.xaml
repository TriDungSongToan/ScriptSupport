<UserControl x:Class="ScriptSupport.UserControls.FooterEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:ScriptSupport.UserControls"
             xmlns:Converters="clr-namespace:ScriptSupport.Converters"
             mc:Ignorable="d" 
             Height="15" d:DesignWidth="600" >

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ScriptSupport;component/Styles/ComboBoxStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Converters:FontSizeTextConverter x:Key="FontSizeTextConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{Binding UIConfig.SolidBackground}" BorderThickness="0,0.5,0,0"
            BorderBrush="{Binding UIConfig.Foreground}" >
        <Grid Background="Transparent" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <ComboBox x:Name="cmbFontSize" Grid.Column="0" IsEditable="True"
                      Width="40" Margin="0,1,0,0" Padding="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      BorderThickness="0,0,1,0"
                      FontSize="12"
                      Background="{Binding UIConfig.SolidBackground}"
                      Foreground="{Binding UIConfig.Foreground}"
                      Style="{StaticResource EditableComboBoxStyle}"
                      ItemsSource="{Binding FontSizeList}"
                      Text="{Binding FontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource FontSizeTextConverter}}" />

            <ScrollBar x:Name="HorizontalScrollBar" Grid.Column="1" Orientation="Horizontal"
                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3,0,3,0"
                       Minimum="0" Maximum="{Binding ScrollableWidth}" Value="{Binding HorizontalOffset, Mode=TwoWay}"
                       ViewportSize="{Binding ViewportWidth}"
                       Style="{StaticResource MaterialDesignScrollBarMinimal}"
                       Background="{Binding UIConfig.Background}"
                       Foreground="{Binding UIConfig.Foreground}"
                       materialDesign:ThemeAssist.Theme="Dark"
                       
                       materialDesign:ScrollViewerAssist.IgnorePadding="True"
                       materialDesign:ScrollBarAssist.ButtonsVisibility="Visible"
                       materialDesign:ScrollBarAssist.ThumbCornerRadius="5"
                       materialDesign:ScrollBarAssist.ThumbHeight="12"
                       materialDesign:ScrollViewerAssist.ShowSeparators="True"
                       materialDesign:ScrollViewerAssist.SupportHorizontalScroll="True" >
            </ScrollBar>

            <Border Grid.Column="2" Background="Transparent" BorderThickness="0.2,0,0.2,0"
                    BorderBrush="{Binding UIConfig.Foreground}" >
                <StackPanel Orientation="Horizontal" Width="auto" MinWidth="30" Margin="5,0,5,0" >
                    <TextBlock Text="Ln: " HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{Binding UIConfig.Foreground}" FontSize="10" />
                    <TextBlock Text="{Binding CaretLine, Mode=OneWay}" 
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{Binding UIConfig.Foreground}" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Background="Transparent" BorderThickness="0.3,0,0.3,0"
                    BorderBrush="{Binding UIConfig.Foreground}" >
                <StackPanel Orientation="Horizontal" Width="auto" MinWidth="30" Margin="5,0,5,0" >
                    <TextBlock Text="Ch: " HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{Binding UIConfig.Foreground}" FontSize="10" />
                    <TextBlock Text="{Binding CaretColumn, Mode=OneWay}" 
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Foreground="{Binding UIConfig.Foreground}" FontSize="11" />
                </StackPanel>
            </Border>

            <ComboBox x:Name="cmbTabSpc" Grid.Column="4" IsEditable="False"
                      Width="30" Margin="0,1,0,0" Padding="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Background="{Binding UIConfig.SolidBackground}"
                      Foreground="{Binding UIConfig.Foreground}"
                      FontSize="11"
                      Style="{StaticResource OptionComboBoxStyle}"
                      
                      ItemsSource="{Binding IndentOptions}"
                      SelectedItem="{Binding SelectedIndentOption, Mode=TwoWay}" />

            <Border Grid.Column="5" Background="Transparent" Width="auto" Padding="5,0,5,0" BorderThickness="0.3,0,0.3,0"
                    BorderBrush="{Binding UIConfig.Foreground}">
                <TextBlock Text="OVR" Margin="0" Padding="0" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding UIConfig.Foreground}" />
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverstrikeMode}" Value="True" >
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>

            <ComboBox x:Name="cmbEncodeNewLine" Grid.Column="6" IsEditable="False"
                      Width="30" Margin="0,1,0,0" Padding="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Background="{Binding UIConfig.SolidBackground}"
                      Foreground="{Binding UIConfig.Foreground}"
                      FontSize="11"
                      Style="{StaticResource OptionComboBoxStyle}"
                      
                      ItemsSource="{Binding NewLineOptions}"
                      SelectedItem="{Binding SelectedNewLineOption, Mode=TwoWay}" />
        </Grid>
    </Border>
</UserControl>
