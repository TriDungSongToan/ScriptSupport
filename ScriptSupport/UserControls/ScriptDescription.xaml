<UserControl x:Class="ScriptSupport.UserControls.ScriptDescription"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:avalonEdit="clr-namespace:ICSharpCode.AvalonEdit;assembly=ICSharpCode.AvalonEdit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScriptSupport.UserControls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:Behaviors="clr-namespace:ScriptSupport.Behaviors"
             xmlns:Converters="clr-namespace:ScriptSupport.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ToolTip">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{Binding DataContext.UIConfig.Background, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderThickness="0.5" Padding="6" CornerRadius="4">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  TextElement.Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  TextElement.FontFamily="{Binding DataContext.UIConfig.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="RichTextBox" BasedOn="{StaticResource MaterialDesignFilledRichTextBox}" >
                <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" />
            </Style>

            <Style TargetType="avalonEdit:TextEditor" >
                <Setter Property="ContextMenu" Value="{StaticResource EditorContextMenu}" />
            </Style>

            <Converters:WidthToVisibilityConverter x:Key="WidthToVisibilityHeader" Threshold="70"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="BorderRoot" CornerRadius="3" BorderThickness="1" MaxWidth="800" Padding="10,3,0,0"
            Background="{Binding UIConfig.Background}"
            BorderBrush="{Binding UIConfig.Foreground}" >
        <Grid>
            <avalonEdit:TextEditor x:Name="ScriptDescriptionPane"
                                   xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
                                   Document="{Binding Document}"
                                   IsReadOnly="True" ShowLineNumbers="False"
                                   IsHitTestVisible="True"
                                   Background="{Binding UIConfig.Background}"
                                   Foreground="{Binding UIConfig.Foreground}"
                                   FontFamily="{Binding UIConfig.FontFamily}"
                                   FontSize="13"
                                   VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Auto"
                                   HorizontalContentAlignment="Left"
                                   VerticalContentAlignment="Top"
                                   HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   SyntaxHighlighting="{Binding SyntaxHighlighting}"
                                   WordWrap="True" >
                <avalonedit:TextEditor.Options>
                    <avalonedit:TextEditorOptions EnableHyperlinks="True" EnableEmailHyperlinks="True" />
                </avalonedit:TextEditor.Options>
                <avalonEdit:TextEditor.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="{Binding UIConfig.Background}" />
                        <Setter Property="Opacity" Value="0.5" />
                    </Style>
                </avalonEdit:TextEditor.Resources>
            </avalonEdit:TextEditor>
        </Grid>
    </Border>
</UserControl>
