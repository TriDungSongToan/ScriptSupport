<UserControl x:Class="ScriptSupport.UserControls.SpecialCharacter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sdl="clr-namespace:Sdl.MultiSelectComboBox.Themes.Generic;assembly=Sdl.MultiSelectComboBox"
             xmlns:local="clr-namespace:ScriptSupport.UserControls"
             xmlns:Converters="clr-namespace:ScriptSupport.Converters"
             xmlns:Localization="clr-namespace:ScriptSupport.Localization"
             mc:Ignorable="d"
             Background="Transparent"
             d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="ToolTip">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{Binding DataContext.UIConfig.Background, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderThickness="0.5" Padding="6" CornerRadius="4">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  TextElement.Foreground="{Binding DataContext.UIConfig.Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  TextElement.FontFamily="{Binding DataContext.UIConfig.FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Converters:SelectedItemsToVisibilityConverter x:Key="SelectedItemsToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <materialDesign:Card UniformCornerRadius="5" BorderThickness="0"
                         d:FlowDirection="LeftToRight"
                         Background="Transparent"
                         BorderBrush="{Binding UIConfig.ThemeColor}" >
        <Grid Width="300" Height="300" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Height="35"
                          BorderThickness="0.7" IsEditable="False" Padding="5,13,12,0"
                          BorderBrush="{Binding UIConfig.ThemeColor}"
                          Background="{Binding UIConfig.Background}"
                          Foreground="{Binding UIConfig.Foreground}"
                          FontFamily="{Binding UIConfig.FontFamily}"
                          FontSize="14"
                          ItemsSource="{Binding CharacterGroups}"
                          SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                          VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                          materialDesign:ColorZoneAssist.Mode="Custom"
                          materialDesign:HintAssist.Hint="{Localization:Lang Group}"
                          Style="{StaticResource MaterialDesignFilledComboBox}"
                          TextOptions.TextFormattingMode="Display"
                          TextOptions.TextRenderingMode="ClearType"
                          materialDesign:TextFieldAssist.TextFieldCornerRadius="5" 
                          materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10" >
                    <ComboBox.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                            <Setter Property="Opacity" Value="0.5" />
                        </Style>
                    </ComboBox.Resources>
                </ComboBox>

                <TextBox Grid.Column="2" Height="35"
                         Padding="5,7,5,0" BorderThickness="0.7"
                         Text="{Binding SubCategory, UpdateSourceTrigger=PropertyChanged}"
                         BorderBrush="{Binding UIConfig.ThemeColor}"
                         Background="Transparent"
                         Foreground="{Binding UIConfig.Foreground}"
                         FontFamily="{Binding UIConfig.FontFamily}"
                         FontSize="14"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                         materialDesign:HintAssist.Hint="{Localization:Lang cardLabelCategory}"
                         Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                         TextOptions.TextFormattingMode="Display"
                         TextOptions.TextRenderingMode="ClearType"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                         materialDesign:ThemeAssist.Theme="Dark" />

            </Grid>

            <Grid Grid.Row="2" >
                <TextBox Height="35"
                         Padding="5,7,5,0" BorderThickness="0.7"
                         Text="{Binding Desc, UpdateSourceTrigger=PropertyChanged}"
                         BorderBrush="{Binding UIConfig.ThemeColor}"
                         Background="Transparent"
                         Foreground="{Binding UIConfig.Foreground}"
                         FontFamily="{Binding UIConfig.FontFamily}"
                         FontSize="14"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Stretch" HorizontalContentAlignment="Left"
                         materialDesign:HintAssist.Hint="{Localization:Lang cardDesc}"
                         Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                         TextOptions.TextFormattingMode="Display"
                         TextOptions.TextRenderingMode="ClearType"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                         materialDesign:ThemeAssist.Theme="Dark" />
            </Grid>

            <Grid Grid.Row="4" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
                <TextBox Grid.Column="0" Padding="0" Margin="0" BorderThickness="0.7"
                         Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                         Text="{Binding Character}"
                         BorderBrush="{Binding UIConfig.ThemeColor}"
                         Background="Transparent"
                         Foreground="{Binding UIConfig.Foreground}"
                         FontFamily="{Binding UIConfig.FontFamily}"
                         FontSize="45"
                         TextAlignment="Center"
                         VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                         VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                         materialDesign:HintAssist.Hint=""
                         Style="{StaticResource CustomMaterialDesignFilledTextBox}"
                         TextOptions.TextFormattingMode="Display"
                         TextOptions.TextRenderingMode="ClearType"
                         materialDesign:TextFieldAssist.TextFieldCornerRadius="5"
                         materialDesign:TextFieldAssist.UnderlineCornerRadius="0,0,10,10"
                         materialDesign:ThemeAssist.Theme="Dark" />

                <Grid Grid.Column="2" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="0.7" CornerRadius="5"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            BorderBrush="{Binding UIConfig.ThemeColor}" Padding="0" Margin="0" >
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <sdl:MultiSelectComboBox x:Name="cmbTags" Grid.Column="0" Height="35" Margin="0" Padding="0"
                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                     HorizontalContentAlignment="Left" VerticalContentAlignment="Center"
                                                     Background="{Binding UIConfig.Background}"
                                                     Foreground="{Binding UIConfig.Foreground}"
                                                     FontFamily="{Binding UIConfig.FontFamily}"
                                                     IsEnabled="True" MaxDropDownHeight="200" IsEditable="True"
                                                     ClearFilterOnDropdownClosing="True" SelectionMode="Multiple"
                                                     EnableAutoComplete="True" EnableBatchSelection="True"
                                                     EnableFiltering="True" EnableGrouping="True"
                                                     ClearSelectionOnFilterChanged="True"
                                                     Style="{StaticResource MultiSelectComboBox.Custom.Style}"
                                                     ItemsSource="{Binding AvailableTags}"
                                                     SelectedItems="{Binding SelectedAvailableTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" >
                            
                                <sdl:MultiSelectComboBox.DropdownItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Margin="5" TextAlignment="Left"
                                                       Background="Transparent"
                                                       Foreground="{Binding Foreground, ElementName=cmbTags}"
                                                       FontFamily="{Binding FontFamily, ElementName=cmbTags}"
                                                       HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </sdl:MultiSelectComboBox.DropdownItemTemplate>
                                <sdl:MultiSelectComboBox.SelectedItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" Margin="5,0,5,0"
                                                   Background="Transparent"
                                                   Foreground="{Binding Foreground, ElementName=cmbTags}"
                                                   FontFamily="{Binding FontFamily, ElementName=cmbTags}"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </DataTemplate>
                               </sdl:MultiSelectComboBox.SelectedItemTemplate>
                           </sdl:MultiSelectComboBox>
                            <TextBlock Grid.Column="0" Opacity="0.5" Margin="0,0,25,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Text="Tags" IsHitTestVisible="False"
                                       Background="Transparent"
                                       Foreground="{Binding UIConfig.Foreground}" 
                                       FontFamily="{Binding UIConfig.FontFamily}" 
                                       FontSize="{Binding UIConfig.FontSize}"
                                       Visibility="{Binding SelectedAvailableTags, Converter={StaticResource SelectedItemsToVisibilityConverter}}" />
                        </Grid>

                    </Border>

                    <Grid Grid.Row="2" Height="30" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Width="auto" MinWidth="60" Height="auto"
                                BorderThickness="0" Margin="0" Padding="10,0,10,0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Style="{StaticResource MaterialDesignPaperSecondaryDarkButton}"
                                Command="{Binding InsertCommand}" >
                            <TextBlock Text="{Localization:Lang Insert}" FontSize="13"
                                           FontFamily="{Binding UIConfig.FontFamily}"
                                           Foreground="{Binding UIConfig.Foreground}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Button.Background>
                                <SolidColorBrush Color="#1976D2" Opacity="0.8" />
                            </Button.Background>
                        </Button>

                        <Button Grid.Column="2" Width="auto" MinWidth="60" Height="auto"
                                BorderThickness="0" Margin="0" Padding="10,0,10,0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Style="{StaticResource MaterialDesignPaperSecondaryDarkButton}"
                                Command="{Binding CopyCommand}" >
                            <TextBlock Text="{Localization:Lang Copy}" FontSize="13"
                                           FontFamily="{Binding UIConfig.FontFamily}"
                                           Foreground="{Binding UIConfig.Foreground}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Button.Background>
                                <SolidColorBrush Color="#546E7A" Opacity="0.8" />
                            </Button.Background>
                        </Button>

                        <Button Grid.Column="4" Width="auto" Height="auto"
                                BorderThickness="0" Margin="0" Padding="0"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                materialDesign:ButtonAssist.CornerRadius="5"
                                Style="{StaticResource MaterialDesignPaperSecondaryDarkButton}"
                                Command="{Binding ClearFilterCommand}" >
                            <TextBlock Text="{Localization:Lang clearFilter}" FontSize="13"
                                           FontFamily="{Binding UIConfig.FontFamily}"
                                           Foreground="{Binding UIConfig.Foreground}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Button.Background>
                                <SolidColorBrush Color="#FB8C00" Opacity="0.8" />
                            </Button.Background>
                        </Button>

                    </Grid>
                </Grid>

            </Grid>

            <ListBox Grid.Row="6" Margin="0" Padding="0" BorderThickness="0.7"
                     BorderBrush="{Binding UIConfig.ThemeColor}"
                     Background="Transparent"
                     Foreground="{Binding UIConfig.Foreground}"
                     FontFamily="{Binding UIConfig.FontFamily}"
                     FontSize="{Binding UIConfig.FontSize}"
                     ItemsSource="{Binding CharacterItems}"
                     SelectedItem="{Binding SelectedCharItem, Mode=TwoWay}"
                     materialDesign:ListBoxItemAssist.CornerRadius="0"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" >
                            <TextBlock Text="{Binding Character}" Width="25" Margin="5,0,0,0"
                                       Background="Transparent" />
                            <TextBlock Text="{Binding Description}" Background="Transparent" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                        <Setter Property="Padding" Value="3"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            
        </Grid>
    </materialDesign:Card>
</UserControl>
